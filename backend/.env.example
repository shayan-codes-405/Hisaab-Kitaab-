# HisabKitab Backend Environment Configuration
# MongoDB connection URI (e.g. MongoDB Atlas cluster on Render)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=hisabkitab_db

# Security
SECRET_KEY=generate_a_strong_random_secret_here
TOKEN_EXPIRE_HOURS=24

# Server & CORS
PORT=8000
FRONTEND_ORIGIN=https://hisab-kitaab.vercel.app
CORS_ORIGINS=https://hisab-kitaab.vercel.app,http://localhost:5173

# Optional: TextBee Android SMS Gateway Integration
TEXTBEE_API_URL=https://api.textbee.dev/api/v1
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
TEXTBEE_DEMO_MODE=false
